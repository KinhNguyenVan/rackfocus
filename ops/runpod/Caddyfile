# Caddy trong pod: HTTP thuần, KHÔNG auto-TLS.
#
# RunPod đã cắt TLS ở proxy Cloudflare của họ (https://<podid>-8080.proxy.runpod.net),
# nên bật auto-TLS ở đây là vừa vô ích vừa hỏng: Caddy sẽ đi xin cert cho một domain
# nó không sở hữu.

:{$POD_PORT:8080} {
	encode gzip zstd

	# /ping ĐỨNG NGOÀI basic_auth, có chủ ý: RunPod Serverless load-balancing gọi nó để
	# biết worker đã sẵn sàng chưa, và nó KHÔNG gửi được basic auth. Bị 401 thì LB coi
	# worker là hỏng, thay worker, và vòng tải snapshot 3.8GB bắt đầu lại — vô tận.
	# Endpoint này không tiết lộ gì: chỉ có mã trạng thái, không có body.
	handle /ping {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		# start.sh ghi file này: rỗng nếu không đặt POD_USER/POD_PASS_HASH, còn không
		# thì chứa block basic_auth. Cần cho POD vì URL proxy của RunPod là PUBLIC — ai
		# có pod id là gọi được /api/search, tức đốt quota Cerebras của bạn.
		# Trên SERVERLESS thì để trống: RunPod đã bắt Bearer token ở trước.
		import /etc/caddy/auth.conf

		@api path /api/* /ws/* /healthz /readyz
		handle @api {
			reverse_proxy 127.0.0.1:8000 {
				# Worst case của BE: llm 6s + encode 15s + search 30s = 51s. Để 60s là
				# còn biên, mà vẫn dưới hạn 100s của Cloudflare (pod) và 5,5 phút của
				# serverless — quá hạn thì client nhận 524 của Cloudflare, không phải
				# lỗi của mình, rất khó lần.
				transport http {
					read_timeout 60s
				}
			}
		}

		handle {
			root * /srv
			# SPA: route phía client (vd /video/L30_V046) phải trả về index.html chứ
			# không phải 404. Bản compose cũ không cần vì fe container tự lo.
			try_files {path} /index.html
			file_server
		}
	}

	# ── Cửa sổ BE chưa lên: /ping PHẢI là 204, KHÔNG được là 502 ────────────────
	# Caddy nghe được sau ~2s, còn uvicorn cần thêm 2-4s để import (litellm/boto3/grpc
	# nặng). Trong khoảng đó reverse_proxy nhận "connection refused" và trả 502.
	#
	# 502 ở /ping là lỗi CHÍ TỬ trên RunPod Serverless: LB coi worker là hỏng, huỷ nó,
	# dựng worker mới -> vòng nạp 3.8GB bắt đầu lại -> lặp vô tận. Health check của họ
	# chạy mỗi ~1.1s nên gần như chắc chắn đụng cửa sổ này ở MỌI lần worker khởi động.
	#
	# Đo tại chỗ trên đúng ảnh này (log worker thật cũng cho y hệt):
	#   t+2s  không kết nối được   t+4s  502 (<- chỗ chết người)   t+6s  204
	#
	# Trả 204 = "đang khởi tạo", đúng ngữ nghĩa: worker CHƯA hỏng, chỉ chưa xong.
	handle_errors {
		@ping path /ping
		respond @ping 204

		# Đường khác giữ nguyên mã lỗi thật, đừng che.
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
