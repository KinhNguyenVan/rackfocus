# ── Bí mật ─────────────────────────────────────────────
PG_PASS=devpass123
LLM_API_KEY=

# ── Postgres / Redis ───────────────────────────────────
# Lưu ý: env_file KHÔNG nội suy ${}, phải viết thẳng mật khẩu vào đây
DATABASE_URL=postgresql+asyncpg://vs:devpass123@postgres:5432/rackfocus
REDIS_URL=redis://redis:6379/0

# ── Search core ────────────────────────────────────────
SEARCHCORE_TARGET=unix:///var/run/searchcore/sc.sock
SC_SOCKET_PATH=/var/run/searchcore/sc.sock
SC_STUB_MODE=1
SNAPSHOT_DIR=/data/snapshots/current
ENCODER_PATH=
OMP_NUM_THREADS=4
FAISS_EF_SEARCH=64
RERANK_CANDIDATES=800

# ── Object storage (R2) — để trống lúc này, chưa dùng ───
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# ── Deploy ─────────────────────────────────────────────
DOMAIN=localhost
TAG=latest