# env_file của compose KHÔNG nội suy ${} — viết thẳng giá trị.

PG_PASS=devpass123
DATABASE_URL=postgresql+asyncpg://vs:devpass123@postgres:5432/rackfocus
MONGO_URI=mongodb://localhost:27017
MONGO_DB=

# ── S3 ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=aic-bucket-2026
CLOUDFRONT_DOMAIN=

# ── LLM ─────────────────────────────────────────────────────────────
# litellm tự đọc key theo provider; *_API_KEY để trống là dùng các key này.
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model tách riêng có chủ ý: BE chọn tag trong hot path (nhanh, rẻ), ingest phân
# đoạn video (chậm được, nhưng BẮT BUỘC provider hỗ trợ json_schema — groq thì không).
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TIMEOUT_S=6
LLM_TEMPERATURE=0
LLM_MAX_TAGS=5
LLM_ENABLED=1

DOMAIN_LLM_MODEL=cerebras/gpt-oss-120b
DOMAIN_LLM_API_KEY=
DOMAIN_LLM_API_BASE=
DOMAIN_LLM_TIMEOUT_SECONDS=60
DOMAIN_LLM_MAX_TOKENS=256000
DOMAIN_REASONING_EFFORT=medium

# ── Search core ─────────────────────────────────────────────────────
SEARCHCORE_TARGET=unix:///var/run/searchcore/sc.sock
SC_SOCKET_PATH=/var/run/searchcore/sc.sock
SC_STUB_MODE=1                 # 1 = trả kết quả giả, chưa nạp snapshot
SC_VERIFY_CHECKSUMS=1
SC_WARMUP_QUERIES=50
SC_MAX_CONCURRENT_ENCODES=2

# SNAPSHOT_DIR/ENCODER_PATH (bind mount) thắng bản S3 nếu khai cả hai.
SNAPSHOT_DIR=
SNAPSHOT_S3=s3://aic-bucket-2026/snapshots/v1
ENCODER_PATH=
ENCODER_S3=s3://aic-bucket-2026/models/siglip-so400m-patch14-384-text-onnx
ENCODER_NAME=siglip-so400m-patch14-384
MODEL_CACHE_DIR=/var/cache/searchcore   # phải là volume RW bền

VECTOR_DIM=0                   # 0 = lấy theo manifest, không kiểm
FAISS_EF_SEARCH=64
RERANK_CANDIDATES=800
EXACT_SUBSET_MAX=20000
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4

# ── Ingest ──────────────────────────────────────────────────────────
SIGLIP_MODEL_PATH=

# ── Deploy ──────────────────────────────────────────────────────────
DOMAIN=localhost
TAG=latest
