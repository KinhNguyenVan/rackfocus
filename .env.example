# ── Bí mật ─────────────────────────────────────────────
PG_PASS=devpass123
LLM_API_KEY=

# ── Postgres / Redis ───────────────────────────────────
# Lưu ý: env_file KHÔNG nội suy ${}, phải viết thẳng mật khẩu vào đây
DATABASE_URL=postgresql+asyncpg://vs:devpass123@postgres:5432/rackfocus
REDIS_URL=redis://redis:6379/0

# ── Search core ────────────────────────────────────────
SEARCHCORE_TARGET=unix:///var/run/searchcore/sc.sock
SC_SOCKET_PATH=/var/run/searchcore/sc.sock
SC_STUB_MODE=1
SNAPSHOT_DIR=/data/snapshots/current
ENCODER_PATH=
OMP_NUM_THREADS=4
FAISS_EF_SEARCH=64
RERANK_CANDIDATES=800


# ── Deploy ─────────────────────────────────────────────
DOMAIN=localhost
TAG=latest

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=aic-bucket-2026
CLOUDFRONT_DOMAIN=

# ── Ingest ─────────────────────────────────────────────
SIGLIP_MODEL_PATH=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_TIMEOUT_SECONDS=60
CEREBRAS_MAX_COMPLETION_TOKENS=32768
CEREBRAS_REASONING_EFFORT=medium
DOMAIN_PROVIDER=cerebras
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_THINKING_LEVEL=medium
MONGO_URI=mongodb://localhost:27017
# Tuỳ chọn: override database trong URI; mặc định rackfocus
MONGO_DB=
