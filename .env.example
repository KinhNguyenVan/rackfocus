# Copy sang .env rồi điền. `.env` đã nằm trong .gitignore — KHÔNG commit.
# Mọi biến dạng *_KEY / *_API_KEY để TRỐNG ở file này, tự điền vào .env.
#
# env_file của compose KHÔNG nội suy ${} — viết thẳng giá trị.
#
# Chạy local (không docker) thì .env này được đọc bởi:
#   - BE: pydantic-settings, env_file=".env" — tương đối với CWD, nên phải chạy
#     uvicorn từ thư mục gốc repo, không phải từ services/be.
#   - clients/s3.py: load_dotenv() lúc import.
#   - core: KHÔNG đọc .env, chỉ đọc biến môi trường thật -> `set -a; . ./.env; set +a`.
# Xem README §"Chạy local".

# ── DB ──────────────────────────────────────────────────────────────
# CHỈ `services/ingest` (offline) dùng hai biến Postgres này, để cấp video_id/scene_idx
# cho payload embedding (ingest/db.py + pipeline.py). Stack online (be, core) KHÔNG dùng
# Postgres, và compose đã bỏ service postgres — xem ghi chú trong docker-compose.yml.
# Host `postgres` bên dưới là tên service cũ; chạy ingest ngoài compose thì đổi thành
# localhost hoặc host thật.
PG_PASS=devpass123
DATABASE_URL=postgresql+asyncpg://vs:devpass123@postgres:5432/rackfocus

# Mongo: chỉ `ingest/domain/` dùng (kết quả phân tích domain -> build_tags.py đọc ra để
# sinh tags.npy). Không có service mongo trong compose vì bản đang dùng là Atlas remote.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=

# ── S3 ──────────────────────────────────────────────────────────────
# BẮT BUỘC cho: core tải snapshot/encoder, và BE /api/neighbors (clients/s3.py).
# Thiếu key thì core không nạp nổi snapshot và /api/neighbors trả 502.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=aic-bucket-2026
CLOUDFRONT_DOMAIN=

# ── LLM ─────────────────────────────────────────────────────────────
# litellm tự đọc key theo provider; *_API_KEY để trống là dùng các key này.
# Không có key nào cũng chạy được: BE fallback sang search toàn corpus không lọc tag
# (hoặc tắt hẳn bằng LLM_ENABLED=0 / toggle "tắt LLM" trên UI).
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model tách riêng có chủ ý: BE chọn tag trong hot path (nhanh, rẻ), ingest phân
# đoạn video (chậm được, nhưng BẮT BUỘC provider hỗ trợ json_schema — groq thì không).
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TIMEOUT_S=6
LLM_TEMPERATURE=0
LLM_MAX_TAGS=5
# Model reasoning (gpt-oss...) tiêu token cho reasoning TRƯỚC khi sinh content. 400 là
# quá ít: query dài -> finish_reason=length -> JSON cụt -> enrich tắt trong im lặng.
LLM_MAX_TOKENS=2000
# low/medium/high, rỗng = không gửi (model không reasoning sẽ lỗi nếu nhận).
LLM_REASONING_EFFORT=
LLM_ENABLED=1

DOMAIN_LLM_MODEL=cerebras/gpt-oss-120b
DOMAIN_LLM_API_KEY=
DOMAIN_LLM_API_BASE=
DOMAIN_LLM_TIMEOUT_SECONDS=60
DOMAIN_LLM_MAX_TOKENS=256000
DOMAIN_REASONING_EFFORT=medium

# ── BE ──────────────────────────────────────────────────────────────
# Tên biến = tên field trong services/be/src/app/config.py (không có env_prefix).
#
# Địa chỉ core. Compose dùng Unix socket (cùng máy, ~0.1ms). Chạy local trực tiếp
# thì core listen TCP -> đổi thành localhost:50051.
SEARCHCORE_TARGET=unix:///var/run/searchcore/sc.sock

# Deadline gRPC. KHÔNG để 200ms như thiết kế ban đầu: encoder SigLIP so400m tốn
# 53.3 GFLOP/query nên chỉ riêng encode đã 170-420ms trên 4 core. Corpus thật 613k
# điểm + chế độ "exact" brute-force cả corpus -> để rộng, thà chậm hơn là timeout.
ENCODE_TIMEOUT_S=15
SEARCH_TIMEOUT_S=30

DEFAULT_TOP_K=20
# 300 = khớp thiết kế 2-tier (coarse top ~1k -> rerank exact top 300). FE xin 300,
# để thấp hơn là bị cắt âm thầm.
MAX_TOP_K=300

# 0 = tắt dedup theo video, trả nguyên top_k theo đúng thứ tự core xếp hạng. Đặt >0
# (ví dụ 3) để chặn 7 keyframe cùng một shot chiếm hết trang, đổi lại top_k lớn sẽ bị
# cắt còn vài chục nếu match dồn vào ít video.
DIVERSITY_MAX_PER_VIDEO=0
DIVERSITY_MIN_TIME_GAP_SEC=0
DIVERSITY_DEDUP_THRESHOLD=0

# ── Transcript keyword search (tuỳ chọn) ────────────────────────────
# Đường dẫn transcript.sqlite (FTS5) dựng bằng `python -m ingest.build_transcript_index
# --from-s3`. Rỗng = tắt: /api/transcript/suggest trả 503, phần còn lại chạy như cũ.
TRANSCRIPT_DB_PATH=
TRANSCRIPT_SUGGEST_LIMIT=10

# ── Search core ─────────────────────────────────────────────────────
SC_SOCKET_PATH=/var/run/searchcore/sc.sock
# Chỉ dùng khi chạy local trực tiếp (không có Unix socket dùng chung).
SC_TCP_PORT=50051

# 1 = trả kết quả GIẢ, không nạp snapshot. Phải đặt 0 để search dữ liệu thật —
# quên đổi là nguyên nhân số 1 của "search chạy nhưng kết quả vô nghĩa".
SC_STUB_MODE=1

SC_VERIFY_CHECKSUMS=1
SC_WARMUP_QUERIES=50
SC_MAX_WORKERS=8
SC_MAX_CONCURRENT_ENCODES=2

# SNAPSHOT_DIR/ENCODER_PATH (bind mount) thắng bản S3 nếu khai cả hai.
SNAPSHOT_DIR=
SNAPSHOT_S3=s3://aic-bucket-2026/snapshots/v1
ENCODER_PATH=
ENCODER_S3=s3://aic-bucket-2026/models/siglip-so400m-patch14-384-text-onnx
ENCODER_NAME=siglip-so400m-patch14-384
# Phải là volume RW bền: lần đầu tải ~1.8GB encoder + snapshot từ S3, sau đó dùng
# cache (đánh dấu bằng file .s3_download_done). Chạy local thì trỏ vào thư mục ghi được.
MODEL_CACHE_DIR=/var/cache/searchcore

VECTOR_DIM=0                   # 0 = lấy theo manifest, không kiểm

# ĐỪNG hạ xuống 64 (giá trị cũ): HNSW thăm ~ef_search node rồi mới áp IDSelector, nên
# với tag chiếm 6-10% corpus nó chỉ trả ~4-6 kết quả < top_k -> core rơi về full corpus
# và xoá tags_used. Hậu quả: lọc tag TẮT HẲN, chỉ để lại warnings=["tag_fallback"].
# Đo thật (613k/13 tag, top_k=300): ef=2000 -> recall tag 69-79%, ef=4000 -> 82-84%,
# ef=10000 -> p50 195-219ms, 0 fallback. Search không tag gần như không phụ thuộc ef.
FAISS_EF_SEARCH=4000
# Số candidate đưa sang rerank exact fp16. 1000 khớp thiết kế "coarse ~1k -> exact 300".
RERANK_CANDIDATES=1000
# 100k: 12/13 tag hiện tại <= 61k điểm nên đi đường exact -> recall 100% ở 25-47ms,
# vừa chính xác hơn vừa nhanh hơn HNSW+IDSelector. BẮT BUỘC pin visual.f16 vào RAM
# (vmtouch): 477ms lúc page fault so với 24ms khi warm.
EXACT_SUBSET_MAX=100000

# ── Temporal search (TRAKE) ─────────────────────────────────────────
TRAKE_CANDIDATES_PER_EVENT=500
TRAKE_MAX_PAIRS_PER_VIDEO=5
TRAKE_MIN_GAP_SEC=5.0
TRAKE_MAX_GAP_SEC=120.0
TRAKE_LAMBDA=0.00557
TRAKE_SIM_WEIGHT=0.8
TRAKE_TIME_WEIGHT=0.2
TRAKE_TOP_K_CHAINS=20
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4

# ── FE ──────────────────────────────────────────────────────────────
# Đích proxy /api và /ws của vite (services/fe/vite.config.ts). Bỏ trống = mặc định
# http://localhost:8000. Chạy dưới compose thì đặt http://be:8000 (tên service đó
# không resolve được ngoài network của compose).
VITE_BE_TARGET=

# ── Ingest ──────────────────────────────────────────────────────────
SIGLIP_MODEL_PATH=

# ── Deploy ──────────────────────────────────────────────────────────
DOMAIN=localhost
TAG=latest
