# ── Bí mật ─────────────────────────────────────────────
PG_PASS=devpass123
LLM_API_KEY=

# ── Postgres / Redis ───────────────────────────────────
# Lưu ý: env_file KHÔNG nội suy ${}, phải viết thẳng mật khẩu vào đây
DATABASE_URL=postgresql+asyncpg://vs:devpass123@postgres:5432/rackfocus
REDIS_URL=redis://redis:6379/0

# ── Search core ────────────────────────────────────────
SEARCHCORE_TARGET=unix:///var/run/searchcore/sc.sock
SC_SOCKET_PATH=/var/run/searchcore/sc.sock
SC_STUB_MODE=1
SNAPSHOT_DIR=/data/snapshots/current
ENCODER_PATH=
OMP_NUM_THREADS=4
FAISS_EF_SEARCH=64
RERANK_CANDIDATES=800


# ── Deploy ─────────────────────────────────────────────
DOMAIN=localhost
TAG=latest

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=aic-bucket-2026
CLOUDFRONT_DOMAIN=

# ── Ingest ─────────────────────────────────────────────
SIGLIP_MODEL_PATH=
# ── Search core: nạp lúc start server ──────────────────────────────
# Bind mount thắng S3 nếu có cả hai. Prefix S3 phải IMMUTABLE theo version:
# cache local không có invalidation nên re-upload cùng prefix sẽ cho split-brain.
SNAPSHOT_S3=s3://aic-bucket-2026/snapshots/v1
ENCODER_S3=s3://aic-bucket-2026/models/siglip-so400m-patch14-384-text-onnx
ENCODER_NAME=siglip-so400m-patch14-384
# 0 = lấy dim theo manifest, không kiểm. Chốt số thật rồi điền để bắt lỗi trộn snapshot.
VECTOR_DIM=0
# PHẢI là volume RW bền; hai mount trong compose đều :ro nên mặc định rơi về /tmp
# ephemeral -> tải lại vài GB mỗi lần recreate container.
MODEL_CACHE_DIR=/var/cache/searchcore
EXACT_SUBSET_MAX=20000
SC_MAX_CONCURRENT_ENCODES=2
SC_VERIFY_CHECKSUMS=1
SC_WARMUP_QUERIES=50
OPENBLAS_NUM_THREADS=4

# ── LLM chọn tag (litellm: "provider/model") ────────────────────────
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_TIMEOUT_S=6
LLM_TEMPERATURE=0
LLM_MAX_TAGS=5
LLM_ENABLED=1

# ════════════════════════════════════════════════════════════════════
#  LLM — dùng chung cho services/be và services/ingest
# ════════════════════════════════════════════════════════════════════
# Cả hai service gọi LLM qua litellm và cùng dùng chuỗi "provider/model", nên
# API key khai MỘT LẦN ở đây. litellm tự đọc biến chuẩn của từng provider, không
# cần khai lại theo tên riêng cho từng service.
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model thì CỐ Ý tách riêng, không dùng chung một biến — hai bên làm việc khác nhau:
#
#   BE     chọn tag từ câu query, nằm trong hot path, cần nhanh và rẻ.
#   ingest phân đoạn video có cấu trúc, chạy offline, cần chất lượng và
#          BẮT BUỘC provider hỗ trợ json_schema.
#
# Đã đo: groq/llama-3.3-70b-versatile có supports_response_schema=False, tức nó
# KHÔNG làm được việc của ingest. Ngược lại cerebras/gpt-oss-120b quá chậm/đắt cho
# một lượt chọn tag. Ép chung một biến là hỏng một trong hai.

# ── BE: chọn tag cho query ──────────────────────────────────────────
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=                   # để trống = dùng key theo provider ở trên
LLM_TIMEOUT_S=6
LLM_TEMPERATURE=0
LLM_MAX_TAGS=5
LLM_ENABLED=1

# ── ingest: phân đoạn domain (python -m ingest.domain) ──────────────
DOMAIN_LLM_MODEL=cerebras/gpt-oss-120b
DOMAIN_LLM_API_KEY=            # để trống = dùng key theo provider ở trên
DOMAIN_LLM_API_BASE=           # chỉ cần khi self-host / gateway riêng
DOMAIN_LLM_TIMEOUT_SECONDS=60
DOMAIN_LLM_MAX_TOKENS=32768
# Cerebras gọi là reasoning_effort, Gemini gọi là thinking_level — litellm map giúp.
DOMAIN_REASONING_EFFORT=medium
MONGO_URI=mongodb://localhost:27017
# Tuỳ chọn: override database trong URI; mặc định rackfocus
MONGO_DB=
